# Supabase: Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL=

# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos com plano gratuito: https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-3.8-flash
# Usado quando o modelo principal está sobrecarregado (erro 503)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

PORT=5000
# Em produção, as URLs do frontend separadas por vírgula
CORS_ORIGIN=*

# Gerado pelo Vercel; protege a rota /api/cron/ping
CRON_SECRET=

# Senha das paginas /admin e /orders
ADMIN_PASSWORD=
# Opcional: chave usada para assinar a sessao (padrao: ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
# Duracao da sessao do admin, em horas (padrao: 12)
ADMIN_SESSION_HOURS=12
